node('ec2-worker'){
    properties([
        parameters([
            gitParameter(type: 'PT_BRANCH',
                         name: 'A_BRANCH',
                         branchFilter: 'origin/(.*)',
                         defaultValue: 'main',
                         description: 'Choose a branch for checkout',
                         selectedValue: 'TOP',
                         sortMode: 'ASCENDING_SMART'),
            booleanParam(
                name: 'Deploy', 
                defaultValue: false, 
                description: 'Check this box to deploy code otherwise it runs to testing phase.'
        )
    ])
])

    stage("chekout"){
        cleanWs()
        def rawBranch = env.GIT_BRANCH ?: params.A_BRANCH
        echo "Received branch: ${rawBranch}"

        def targetBranch = rawBranch
            .trim()
            .replaceFirst('^refs/heads/', '')
            .replaceFirst('^origin/', '')

        echo "Final branch to checkout: ${targetBranch}"

        git url: 'https://github.com/Shubhp0712/jenkins-task.git', branch: targetBranch
        echo "${targetBranch}"

        env.SELECTED_BRANCH = targetBranch
    }

    nodejs(nodeJSInstallationName: 'Nodejs-installation'){
        stage("Check for dependency"){
            sh 'node -v'
            sh 'npm -v'
        }
            
        stage("Install pm2"){
            echo "install pm2"
            sh 'npm install pm2 -g'
        }
        stage("Testing"){
            echo "Tesing stage"
            sh 'node -c server.js'
            echo "Testing phase completed successfully."
        }

        if(params.Deploy != false){
            stage("Deploy"){
                echo "Deploy phase"
            }
            stage("Run app"){
                withEnv(["GIT_BRANCH=${env.SELECTED_BRANCH}", "JENKINS_NODE_COOKIE=dontKillMe"]){
                    echo "Run the Node app"
                    sh "pm2 delete my-app || true && pm2 start server.js --name 'my-app'"
                    echo "App has started"
                }
            }
            stage("pipeline completion"){
                echo "pipeline completed successfully."
            }
        }
    }
}